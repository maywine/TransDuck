<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransDuck.MacOS.App.Views.HistoryWindow"
        Width="720" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/TransDuck.png"
        Title="TransDuck History">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Translation history" FontSize="20" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Refresh" Click="HandleRefreshClick" />
      <Button Grid.Column="2" Content="Clear" Click="HandleClearClick" />
    </Grid>
    <ListBox Grid.Row="1" x:Name="HistoryListBox">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="10" Margin="0,3" BorderThickness="1" CornerRadius="6"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" x:Name="StatusTextBlock" TextWrapping="Wrap" />
  </Grid>
</Window>
