<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransDuck.MacOS.App.Views.SettingsWindow"
        Width="680" Height="760" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/TransDuck.png"
        Title="TransDuck Settings">
  <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="12">
    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock Text="Translation provider" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Provider" />
        <ComboBox x:Name="ProviderComboBox" SelectionChanged="HandleProviderSelectionChanged" />
        <TextBlock Text="Endpoint" />
        <TextBox x:Name="EndpointTextBox" PlaceholderText="https://provider.example/v1/..." />
        <TextBlock Text="Model (required for OpenAI-compatible and Ollama)" />
        <TextBox x:Name="ModelTextBox" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="Source language (optional)" />
            <TextBox x:Name="SourceLanguageTextBox" PlaceholderText="auto" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Target language" />
            <TextBox x:Name="TargetLanguageTextBox" Text="zh-Hans" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Timeout (seconds)" />
        <NumericUpDown x:Name="TimeoutNumericUpDown" Minimum="1" Maximum="600" Value="45" />
        <TextBlock x:Name="CredentialLabel" Text="API Key / optional Cookie" />
        <TextBox x:Name="CredentialTextBox" PasswordChar="●"
                 PlaceholderText="Leave blank to keep the saved Keychain item" />
        <TextBlock x:Name="SecondaryCredentialLabel" Text="Volcengine Secret Access Key"
                   IsVisible="False" />
        <TextBox x:Name="SecondaryCredentialTextBox" PasswordChar="●"
                 IsVisible="False" PlaceholderText="Required together with AccessKey ID" />
        <CheckBox x:Name="ClearCredentialCheckBox" Content="Clear the saved credential" />
        <TextBlock x:Name="CredentialStatusTextBlock" Opacity="0.7" />

        <Separator Margin="0,8" />
        <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Proxy mode" />
        <ComboBox x:Name="ProxyModeComboBox" SelectionChanged="HandleProxyModeSelectionChanged">
          <ComboBoxItem Content="System default" Tag="SystemDefault" />
          <ComboBoxItem Content="Custom HTTP proxy" Tag="CustomHttp" />
          <ComboBoxItem Content="Direct connection" Tag="Disabled" />
        </ComboBox>
        <TextBox x:Name="ProxyUriTextBox" PlaceholderText="http://host:port" IsEnabled="False" />

        <Separator Margin="0,8" />
        <TextBlock Text="Global hotkey" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <CheckBox x:Name="CommandCheckBox" Content="Command" IsChecked="True" />
          <CheckBox x:Name="OptionCheckBox" Content="Option" IsChecked="True" />
          <CheckBox x:Name="ControlCheckBox" Content="Control" />
          <CheckBox x:Name="ShiftCheckBox" Content="Shift" />
          <ComboBox x:Name="HotkeyKeyComboBox" Width="100" />
        </StackPanel>
        <Button Content="Request / refresh Accessibility permission"
                HorizontalAlignment="Left" Click="HandleAccessibilityClick" />

        <Separator Margin="0,8" />
        <TextBlock Text="History and startup" FontSize="18" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="Maximum history entries (0 = unlimited)" />
            <NumericUpDown x:Name="MaxEntriesNumericUpDown" Minimum="0" Maximum="10000" Value="100" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Maximum age in days (0 = unlimited)" />
            <NumericUpDown x:Name="MaxAgeNumericUpDown" Minimum="0" Maximum="3650" Value="30" />
          </StackPanel>
        </Grid>
        <CheckBox x:Name="StartAtLoginCheckBox" Content="Start TransDuck when I log in" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Reload" Click="HandleReloadClick" />
      <Button Grid.Column="2" x:Name="SaveButton" Content="Save" Click="HandleSaveClick" />
    </Grid>
  </Grid>
</Window>
