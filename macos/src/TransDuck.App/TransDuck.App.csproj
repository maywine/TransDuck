<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>TransDuck</AssemblyName>
    <RootNamespace>TransDuck.MacOS.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>true</UseAppHost>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\TransDuck.Core\TransDuck.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\src\TransDuck.Infrastructure\TransDuck.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\ui\TransDuck.UI\TransDuck.UI.csproj" />
    <ProjectReference Include="..\TransDuck.Platform.MacOS\TransDuck.Platform.MacOS.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Native" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\..\assets\brand-source-icon\menu_bar_duck_color_46x34.png">
      <Link>Assets\TransDuckMenuBarDuckColor.png</Link>
    </AvaloniaResource>
  </ItemGroup>
</Project>
