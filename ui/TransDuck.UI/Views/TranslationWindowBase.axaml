<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransDuck.UI.Views.TranslationWindowBase"
        Title="{DynamicResource result.window.title}"
        Icon="avares://TransDuck.UI/Assets/TransDuck.png"
        Width="760"
        Height="650"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ResultCardSurfaceBrush" Color="#F7F7F9" />
          <SolidColorBrush x:Key="ResultCardBorderBrush" Color="#DCDCE0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ResultCardSurfaceBrush" Color="#29292C" />
          <SolidColorBrush x:Key="ResultCardBorderBrush" Color="#48484D" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBox.resultText">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="^:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
    </Style>
  </Window.Styles>
  <Border x:Name="RootBorderElement"
          Margin="8"
          Padding="14"
          CornerRadius="10"
          Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
      <Grid x:Name="HeaderPanelElement" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Image Source="avares://TransDuck.UI/Assets/TransDuck.png" Width="38" Height="38" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" FontSize="18"
                     Text="{DynamicResource result.heading.brand}" />
          <TextBlock x:Name="VersionTextBlockElement"
                     FontSize="11"
                     Opacity="0.65"
                     AutomationProperties.AutomationId="ProductVersionTextBlock"
                     AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.HelpText="{DynamicResource result.automation.product_version.help}" />
        </StackPanel>
        <Button x:Name="HistoryButtonElement"
                Grid.Column="2"
                Margin="8,0,0,0"
                Content="{DynamicResource result.button.history}"
                Click="HandleHistoryClick"
                AutomationProperties.AutomationId="HistoryButton" />
        <Button x:Name="SettingsButtonElement"
                Grid.Column="3"
                Margin="8,0,0,0"
                Content="{DynamicResource result.button.settings}"
                Click="HandleSettingsClick"
                AutomationProperties.AutomationId="SettingsButton" />
        <Button x:Name="HideButtonElement"
                Grid.Column="4"
                Margin="8,0,0,0"
                Width="30"
                Height="26"
                Content="×"
                Click="HandleHideClick"
                AutomationProperties.AutomationId="HideButton"
                AutomationProperties.Name="{DynamicResource result.button.hide}" />
      </Grid>

      <TextBox x:Name="InputTextBoxElement"
               Grid.Row="1"
               MinHeight="80"
               MaxHeight="112"
               FontSize="15"
               PlaceholderText="{DynamicResource result.input.placeholder}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.AutomationId="InputTextBox"
               AutomationProperties.Name="{DynamicResource result.automation.input.name}"
               AutomationProperties.HelpText="{DynamicResource result.automation.input.help}" />

      <StackPanel Grid.Row="2" Spacing="12">
        <WrapPanel>
          <Button x:Name="TranslateButtonElement" Classes="accent"
                  Margin="0,0,8,4" Padding="14,8"
                  Click="HandleTranslateClick"
                  AutomationProperties.Name="{DynamicResource result.button.translate}"
                  AutomationProperties.AutomationId="TranslateButton">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{DynamicResource result.button.translate}" FontWeight="SemiBold" />
              <TextBlock x:Name="TranslateShortcutTextBlockElement" Text="Ctrl Enter" />
            </StackPanel>
          </Button>
          <Button x:Name="CancelButtonElement" Margin="0,0,8,4" IsEnabled="False"
                  IsVisible="{Binding IsEnabled, RelativeSource={RelativeSource Self}}"
                  Content="{DynamicResource result.button.cancel}" Click="HandleCancelClick"
                  AutomationProperties.AutomationId="CancelButton" />
          <Button x:Name="RetryButtonElement" Margin="0,0,8,4" IsEnabled="False"
                  IsVisible="{Binding IsEnabled, RelativeSource={RelativeSource Self}}"
                  Content="{DynamicResource result.button.retry}" Click="HandleRetryClick"
                  AutomationProperties.AutomationId="RetryButton" />
        </WrapPanel>
        <WrapPanel>
          <Button x:Name="SelectedTextButtonElement" Margin="0,0,12,6"
                  Content="{DynamicResource result.button.selected_text}" Click="HandleSelectedTextClick"
                  AutomationProperties.AutomationId="SelectedTextButton" />
          <WrapPanel>
            <Button x:Name="CaptureOcrButtonElement" Margin="0,0,8,6"
                    Content="{DynamicResource result.button.capture_ocr}" Click="HandleCaptureOcrClick"
                    AutomationProperties.AutomationId="CaptureOcrButton" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <TextBlock Text="{DynamicResource result.label.ocr_language}" VerticalAlignment="Center" />
              <ComboBox x:Name="OcrLanguageComboBoxElement" Width="116" SelectedIndex="0"
                        AutomationProperties.AutomationId="OcrLanguageBox"
                        AutomationProperties.Name="{DynamicResource result.automation.ocr_language.name}"
                        AutomationProperties.HelpText="{DynamicResource result.automation.ocr_language.help}">
                <ComboBoxItem Tag="en-US" Content="{DynamicResource result.ocr_language.english}" />
                <ComboBoxItem Tag="zh-Hans" Content="{DynamicResource result.ocr_language.simplified_chinese}" />
              </ComboBox>
            </StackPanel>
          </WrapPanel>
        </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Row="3" Spacing="4">
        <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                   Text="{DynamicResource result.target.hint}" />
        <TextBlock x:Name="SelectionHintTextBlockElement" FontSize="12" Opacity="0.8"
                   TextWrapping="Wrap" Text="{DynamicResource result.hint.default}" />
      </StackPanel>
      <TextBlock x:Name="TranslationErrorCodeTextBlockElement"
                 Grid.Row="4"
                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                 TextWrapping="Wrap"
                 IsVisible="False"
                 AutomationProperties.AutomationId="TranslationErrorCodeTextBlock"
                 AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                 AutomationProperties.HelpText="{DynamicResource result.automation.error_code.help}" />

      <ScrollViewer Grid.Row="5"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="{DynamicResource result.automation.output.name}"
                    AutomationProperties.HelpText="{DynamicResource result.automation.output.help}">
        <ItemsControl x:Name="ResultsItemsControlElement"
                      AutomationProperties.AutomationId="ResultItemsControl">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10"
                      Padding="16"
                      CornerRadius="8"
                      Background="{DynamicResource ResultCardSurfaceBrush}"
                      BorderBrush="{DynamicResource ResultCardBorderBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="Medium" FontSize="13" TextWrapping="Wrap" Text="{Binding DisplayName}" />
                      <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                                 Text="{Binding TargetLanguageLabel}" IsVisible="{Binding HasTargetLanguage}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" Opacity="0.8" Text="{Binding Status}" />
                  </Grid>
                  <TextBox Classes="resultText"
                           Text="{Binding Text}" FontSize="16" LineHeight="24"
                           IsReadOnly="True" TextWrapping="Wrap"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           Background="Transparent" BorderThickness="0" Padding="0" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                            Padding="8,2"
                            Content="{DynamicResource result.button.pronounce}"
                            Tag="{Binding PronunciationTerm}"
                            IsVisible="{Binding CanPronounce}"
                            Click="HandlePronounceClick"
                            AutomationProperties.AutomationId="PronounceButton"
                            AutomationProperties.HelpText="{DynamicResource result.automation.pronounce.help}" />
                    <Button Padding="8,2" Content="{DynamicResource result.button.copy_source}"
                            Tag="{Binding Text}" IsEnabled="{Binding CanCopy}"
                            Click="HandleCopySourceClick"
                            AutomationProperties.AutomationId="CopySourceButton" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock x:Name="StatusTextBlockElement"
                   VerticalAlignment="Center"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="StatusTextBlock"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.HelpText="{DynamicResource result.automation.status.help}" />
        <Button x:Name="CopyResultButtonElement"
                Grid.Column="1"
                Content="{DynamicResource result.button.copy}"
                Click="HandleCopyClick"
                AutomationProperties.AutomationId="CopyResultButton" />
      </Grid>
    </Grid>
  </Border>
</Window>
